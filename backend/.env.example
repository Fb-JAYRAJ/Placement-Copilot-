APP_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-string-at-least-32-chars
JWT_SECRET=change-this-in-production-jwt-secret-key-at-least-32-chars
DATABASE_URL=postgresql+psycopg://user:password@pooler-host/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@direct-host/neondb?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://user:password@test-host/neondb?sslmode=require
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LLM_DAILY_QUOTA=40
MAX_UPLOAD_MB=5
