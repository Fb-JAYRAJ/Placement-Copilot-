cat > .gitignore << 'GITIGNORE'
# Secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node and build output
node_modules/
dist/
.vite/

# Playwright
test-results/
playwright-report/
blob-report/

# Logs and editor files
*.log
.DS_Store
.idea/
.vscode/
GITIGNORE